{
  "name": "ai-music-party",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "10.34.5"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "pnpm build && tsc -p tsconfig.test.json",
