    "lint": "eslint . && prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@amp/core": "workspace:*",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.11.0",
    "prettier": "3.9.8",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  }
}
